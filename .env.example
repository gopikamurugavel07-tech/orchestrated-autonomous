# Cyber Reasoning System (CRS) Environment Configuration

# GitHub Integration
GITHUB_USER=gopikamurugavel07-tech
GITHUB_REPO_URL=https://github.com/gopikamurugavel07-tech/crs-platform

# Service Settings
PROJECT_NAME="Cyber Reasoning System (CRS)"
ENVIRONMENT=development
LOG_LEVEL=INFO
MOCK_MODE=true

# Database Configuration
POSTGRES_USER=crs_user
POSTGRES_PASSWORD=crs_password
POSTGRES_DB=crs_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=sqlite+aiosqlite:///:memory:

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Ollama & LLM Reasoning Engine Settings
LLM_PROVIDER=ollama  # Options: ollama, mock, openai
LLM_MODEL=codellama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=codellama
OPENAI_API_KEY=your_openai_api_key_here

# Data & Tool Paths
CRSBENCH_DATA_PATH=/datasets/crsbench
NETWORK_DATA_PATH=/datasets/network
REASONING_DATA_PATH=/datasets/reasoning

# Feature Flags for Security Tools
ENABLE_ZEEK=false
ENABLE_SURICATA=false
ENABLE_AFL=false
